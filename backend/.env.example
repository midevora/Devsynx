# Copy this file to backend/.env and fill in your company GitHub details.
# Create a fine-grained token for the repository with Contents: Read-only access.
# For a private repository, the token is required. Never commit backend/.env.

GITHUB_ORG=your-company-org
GITHUB_REPO=
GITHUB_TOKEN=github_pat_your_token_here
PYTHON_EXECUTABLE=python

# Database: use localhost for local XAMPP/MySQL and AWS RDS host for production.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=devsynx_db_main

PORT=5000
NODE_ENV=development

# Gemini has a free tier. Create a key at https://aistudio.google.com/apikey.
# Upload verification rejects the status update when the score is below 60%.
GEMINI_API_KEY=your-gemini-api-key
# Models are tried from left to right when a model is unavailable or rate-limited.
GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash-lite,gemini-2.5-flash
